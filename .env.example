# Environment Variables Template
# Copy this to .env.local and update with your credentials

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/velour_ecommerce?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://user:password@cluster0.mongodb.net/velour_ecommerce?retryWrites=true&w=majority"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="velour_secret_super_long_random_key_change_in_production_123456789"

# Razorpay Payment Gateway Keys
# Obtain from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mock Payment Setting (set to 'true' to allow simulated checkout without live Razorpay keys)
NEXT_PUBLIC_ENABLE_MOCK_PAYMENT="true"
